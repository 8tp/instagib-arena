# Port the Node server listens on. In production it serves the built client
# (dist/), the stats API, and the /ws/instagib game socket all on this port.
PORT=8787

# Where runtime data (the SQLite stats DB) is stored. Defaults to ./data.
# DATA_DIR=./data
# DATABASE_PATH=./data/instagib.sqlite

# Production WebSocket origin allow-list. When set, only browsers loading the
# app from this origin may open the game socket. Leave unset for same-origin /
# local dev (any localhost origin is allowed in dev automatically).
# APP_BASE_URL=https://your-server.example

# Admin accounts (comma- or space-separated usernames, case-insensitive). These
# accounts get is_admin: the staff badge, all cosmetics (incl. the admin-only
# Crown / Sovereign Aura), the verify-players panel, and the /api/admin API.
# Matching existing accounts are promoted on boot.
# Register your account FIRST, then set this and redeploy. Configured names
# cannot be claimed through public signup. Only existing accounts are promoted.
# ADMIN_USERNAMES=YourName,CoAdmin

# Trusted ingress hops. Defaults to 1 on Railway (RAILWAY_PROJECT_ID is set),
# otherwise 0. Railway overwrites X-Real-IP; its X-Forwarded-For contains extra
# edge addresses. Other proxies use a right-to-left X-Forwarded-For chain.
# HTTP, WebSockets and game identity share this resolver. CF-Connecting-IP is
# ignored. The backend must not be directly reachable by untrusted callers
# when proxy trust is enabled. Never count arbitrary client hops.
# TRUST_PROXY_HOPS=1
# Default: x-real-ip on Railway, x-forwarded-for elsewhere. X-Real-IP permits
# one trusted ingress only, which must overwrite client-supplied values.
# TRUST_PROXY_HEADER=x-real-ip

# Read-only metrics API token. When set, scripts/agents can pull the read-only
# /api/admin/metrics/* endpoints with `Authorization: Bearer <token>` (no browser
# login). It can NEVER mutate accounts (verify/grant reject token auth). Unset =
# token auth disabled (session-only). Generate with: openssl rand -hex 32
# See docs/ADMIN-METRICS-API.md.
# ADMIN_API_TOKEN=
