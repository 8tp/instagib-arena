{
  "name": "instagib-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based, server-authoritative Quake-style instagib FPS. Three.js client + Node WebSocket game server.",
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-native.mjs",
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "predev:lan": "node scripts/ensure-native.mjs && node scripts/lan-url.mjs",
    "dev:lan": "concurrently -k -n web,server -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "predev:server": "node scripts/ensure-native.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "lan": "node scripts/lan-url.mjs",
    "netcode:load": "tsx scripts/netcode-load.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "serve": "npm run build && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:security": "node --import tsx --test tests/security.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "0.184.0",
    "tsx": "^4.20.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
